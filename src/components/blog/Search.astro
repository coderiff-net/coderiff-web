---
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<div class="mb-8" data-blog-search>
  <label for="blog-search-input" class="mb-2 block text-sm font-medium text-heading">Search articles</label>
  <input
    id="blog-search-input"
    type="search"
    placeholder="Search titles, topics, authors…"
    autocomplete="off"
    class="block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-base text-default placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30 dark:border-slate-600 dark:bg-slate-900"
    aria-describedby="blog-search-status"
  />
  <p id="blog-search-status" class="mt-2 text-sm text-muted" aria-live="polite"></p>
  <ul class="mt-6 space-y-5" data-blog-search-results hidden>
    {
      posts.map((post) => (
        <li
          data-blog-search-entry
          data-search-text={[
            post.title,
            post.excerpt,
            post.author,
            post.category?.title,
            ...(post.tags ?? []).map((tag) => tag.title),
          ]
            .filter(Boolean)
            .join(' ')
            .toLowerCase()}
          hidden
        >
          <a class="text-lg font-semibold text-heading hover:text-primary" href={getPermalink(post.permalink, 'post')}>
            {post.title}
          </a>
          <p class="mt-1 text-sm text-muted">
            {getFormattedDate(post.publishDate)}
            {post.author ? ` · ${post.author}` : ''}
            {post.category ? ` · ${post.category.title}` : ''}
          </p>
          {post.excerpt && <p class="mt-2 text-muted dark:text-slate-300">{post.excerpt}</p>}
        </li>
      ))
    }
  </ul>
</div>

<script>
  const searchRoot = document.querySelector<HTMLElement>('[data-blog-search]');
  const searchInput = searchRoot?.querySelector<HTMLInputElement>('input[type="search"]');
  const results = searchRoot?.querySelector<HTMLElement>('[data-blog-search-results]');
  const entries = Array.from(searchRoot?.querySelectorAll<HTMLElement>('[data-blog-search-entry]') ?? []);
  const status = searchRoot?.querySelector<HTMLElement>('#blog-search-status');
  const listing = document.querySelector<HTMLElement>('[data-blog-listing]');
  const pagination = document.querySelector<HTMLElement>('[data-blog-pagination]');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLocaleLowerCase();
    if (results) results.hidden = !query;
    if (listing) listing.hidden = Boolean(query);
    if (pagination) pagination.hidden = Boolean(query);

    const matched = entries.filter((entry) => {
      const isMatch = query.length > 0 && (entry.dataset.searchText ?? '').includes(query);
      entry.hidden = !isMatch;
      return isMatch;
    });

    if (status) {
      status.textContent = query ? `${matched.length} ${matched.length === 1 ? 'article' : 'articles'} found` : '';
    }
  });
</script>
