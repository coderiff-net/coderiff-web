---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { QuickStart as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  commands = [],
  prompt = '$',
  copyLabel = 'Copy',
  copiedLabel = 'Copied',
  items = [],
  actions = [],
  note,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props as Props;

const commandText = commands.map((command) => (typeof command === 'string' ? command : command.command)).join('\n');
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <aw-copy data-text={commandText} class="mx-auto block max-w-3xl">
    <div
      class="overflow-hidden rounded-2xl border border-slate-700/80 bg-slate-900 text-slate-100 shadow-xl ring-1 ring-black/20 dark:ring-white/5"
    >
      <div class="flex items-center justify-between border-b border-slate-700/80 bg-slate-800/60 px-4 py-2.5">
        <span class="flex items-center gap-2">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-red-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-amber-300/80"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
          </span>
          <span class="ml-2 text-xs font-medium text-slate-400">Terminal</span>
        </span>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-md border border-slate-600/60 px-2.5 py-1 text-xs font-medium text-slate-200 transition hover:border-slate-400 hover:bg-slate-700 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          data-aw-copy-button
          data-copy-label={copyLabel}
          data-copied-label={copiedLabel}
          hidden
        >
          <Icon name="tabler:copy" class="h-4 w-4" />
          <span data-aw-copy-text>{copyLabel}</span>
        </button>
      </div>
      <pre
        class="whitespace-pre-wrap break-all px-5 py-5 font-mono text-base leading-relaxed md:px-8 md:py-6 md:text-lg"><code>{commands.map((entry) => {
        const { command, comment } = typeof entry === 'string' ? { command: entry, comment: undefined } : entry;
        return (
          <span class="block">
            {comment && <span class="block text-slate-500"># {comment}</span>}
            <span class="select-none text-slate-500">{prompt} </span>
            <span class="text-slate-100">{command}</span>
          </span>
        );
      })}</code></pre>
    </div>
    <span class="sr-only" aria-live="polite" data-aw-copy-status></span>
  </aw-copy>

  {
    items.length > 0 && (
      <ul class="mx-auto mt-10 grid max-w-5xl gap-8 list-none sm:grid-cols-3 md:mt-12">
        {items.map(({ title: itemTitle, description, icon }) => (
          <li class="text-center">
            <Icon
              name={icon || 'tabler:check'}
              class:list={['mx-auto h-12 w-12 rounded-full p-3 text-white', (classes?.icon as string) ?? 'bg-primary']}
            />
            {itemTitle && <h3 class="mt-3 text-lg font-bold text-heading">{itemTitle}</h3>}
            {description && <p class="mt-1.5 text-muted text-pretty" set:html={description} />}
          </li>
        ))}
      </ul>
    )
  }
  {
    actions.length > 0 && (
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:mt-10">
        {actions.map((action) => (
          <Button {...action} />
        ))}
      </div>
    )
  }
  {note && <p class="mt-4 text-center text-sm text-muted" set:html={note} />}
</WidgetWrapper>

<script>
  import '~/scripts/aw-copy';
</script>
