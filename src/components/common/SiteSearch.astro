<div class="site-search" data-pagefind-ignore>
  <label class="sr-only" for="site-search"
    >{Astro.currentLocale === 'es' ? 'Buscar en todo el sitio' : 'Search the whole site'}</label
  >
  {
    import.meta.env.DEV ? (
      <input
        id="site-search"
        class="dev-search"
        type="search"
        disabled
        placeholder={Astro.currentLocale === 'es' ? 'Disponible en la vista previa' : 'Available in built preview'}
        aria-label={
          Astro.currentLocale === 'es'
            ? 'La búsqueda estará disponible en la vista previa generada'
            : 'Search is available in the built preview'
        }
      />
    ) : (
      <>
        <pagefind-config bundle-path="/pagefind/" lang={Astro.currentLocale ?? 'en'} />
        <pagefind-searchbox
          id="site-search"
          placeholder={Astro.currentLocale === 'es' ? 'Buscar en todo el sitio' : 'Search the whole site'}
          show-sub-results
        />
      </>
    )
  }
</div>

{!import.meta.env.DEV && <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />}
{!import.meta.env.DEV && <script type="module" src="/pagefind/pagefind-component-ui.js" is:inline />}

<style>
  .site-search {
    width: min(18rem, 100%);
    margin: 0.5rem 1rem;
  }

  .dev-search {
    width: 100%;
    border: 1px solid rgb(148 163 184 / 0.45);
    border-radius: 0.5rem;
    background: transparent;
    padding: 0.5rem 0.75rem;
    font: inherit;
  }

  @media (max-width: 1023px) {
    .site-search {
      width: auto;
      margin: 0.75rem 1rem;
    }
  }
</style>
