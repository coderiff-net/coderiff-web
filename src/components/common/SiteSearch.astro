<div class="site-search" data-pagefind-ignore>
  <label class="mb-2 block text-sm font-semibold text-heading" for="site-search">Search the whole site</label>
  {
    import.meta.env.DEV ? (
      <input
        id="site-search"
        class="dev-search"
        type="search"
        disabled
        placeholder="Available in built preview"
        aria-label="Search is available in the built preview"
      />
    ) : (
      <>
        <pagefind-config bundle-path="/pagefind/" lang="en" />
        <pagefind-searchbox id="site-search" placeholder="Search the whole site" show-sub-results />
      </>
    )
  }
</div>

{!import.meta.env.DEV && <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />}
{!import.meta.env.DEV && <script type="module" src="/pagefind/pagefind-component-ui.js" is:inline />}

<style>
  .site-search {
    width: 100%;
    max-width: 42rem;
    margin-top: 2rem;
  }

  .dev-search {
    width: 100%;
    border: 1px solid rgb(148 163 184 / 0.45);
    border-radius: 0.5rem;
    background: transparent;
    padding: 0.5rem 0.75rem;
    font: inherit;
  }

  @media (max-width: 1023px) {
    .site-search {
      width: 100%;
      margin-top: 2rem;
    }
  }
</style>
