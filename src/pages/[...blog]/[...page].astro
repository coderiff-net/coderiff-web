---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import PostTags from '~/components/blog/Tags.astro';
import BlogSearch from '~/components/blog/Search.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { blogListRobots, fetchPosts, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const allPosts = await fetchPosts();
const allCategories = Array.from(
  new Map(allPosts.filter((post) => post.category).map((post) => [post.category!.slug, post.category!])).values()
);
const allTags = Array.from(new Map(allPosts.flatMap((post) => post.tags ?? []).map((tag) => [tag.slug, tag])).values());

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: 'Blog', href: getBlogPermalink() }, { text: `Page ${currentPage}` }]
    : [{ text: 'Blog' }]),
];

const metadata = {
  title: `Blog${currentPage > 1 ? ` - Page ${currentPage}` : ''}`,
  description: 'Notes, ideas and useful things from coderiff.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="Notes, ideas and useful things from coderiff.">The Blog</Headline>
    <BlogSearch posts={allPosts} />
    {allCategories.length > 0 && <PostTags tags={allCategories} class="mb-2" title="Categories:" isCategory />}
    {allTags.length > 0 && <PostTags tags={allTags} title="Topics:" />}
    <div data-blog-listing>
      <BlogList posts={page.data} />
    </div>
    <div data-blog-pagination>
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</Layout>
